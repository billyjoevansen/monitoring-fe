# Supabase
# Project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/public API key, aman untuk dipakai di client (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Service role key - JANGAN taruh di variabel NEXT_PUBLIC_*, jangan dipakai di sisi client (Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Key untuk enkripsi di sisi client, gunakan string acak yang kuat
NEXT_PUBLIC_ENCRYPTION_KEY=<random-strong-secret-key>

# Cloudflare Turnstile (Captcha)
# Site key (public, dari dashboard Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>

# Secret key (rahasia, jangan expose ke client)
TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# Backend API
# URL backend API yang dipakai frontend, sesuaikan dengan environment (local/staging/production)
# NEXT_PUBLIC_API_URL=https://<production-backend-url>
NEXT_PUBLIC_API_URL=http://localhost:5000
